---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import Avatar from "../components/Avatar.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
// The file loader only logs a YAML error: fail the build instead of
// publishing a page without projects.
if (projects.length === 0) {
  throw new Error("No projects loaded from src/data/projects.yaml");
}
const repeated = projects.find(
  (project, i) => i > 0 && project.data.order === projects[i - 1]!.data.order,
);
if (repeated) {
  throw new Error(`order ${repeated.data.order} is used twice in src/data/projects.yaml`);
}

// Shown above the name. Empty hides it.
const availability = "Available for contract and consulting work";
const stack = ["Python", "FastAPI", "PostgreSQL", "AWS", "Docker", "Terraform", "Ansible"];
const email = "hello@abrunacci.dev";
// The contact button prefers to break the address right after the @.
const [emailUser, emailDomain, ...rest] = email.split("@");
if (!emailUser || !emailDomain || rest.length > 0) {
  throw new Error(`Not an email address: ${email}`);
}
const github = "https://github.com/Abrunacci";
const linkedin = "https://www.linkedin.com/in/abrunacci/";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Alejandro Brunacci · Senior Backend Engineer (Python &amp; FastAPI)</title>
  <meta name="description" content="Available for contract and consulting work. 10+ years. Backends for GenAI and data products. Remote, with US time zone overlap.">
  <meta name="author" content="Alejandro Brunacci">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="https://abrunacci.dev/">

  <meta property="og:type" content="profile">
  <meta property="og:site_name" content="Alejandro Brunacci">
  <meta property="og:url" content="https://abrunacci.dev/">
  <meta property="og:title" content="Alejandro Brunacci · Senior Backend Engineer">
  <meta property="og:description" content="Available for contract and consulting work. 10+ years. Backends for GenAI and data products. Remote, with US time zone overlap.">
  <meta property="og:image" content="https://abrunacci.dev/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Alejandro Brunacci, Senior Backend Engineer. Python and FastAPI. Backends for GenAI and data products.">
  <meta property="og:locale" content="en_US">
  <meta property="profile:first_name" content="Alejandro">
  <meta property="profile:last_name" content="Brunacci">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <Font cssVariable="--font-inter" preload />
</head>
<body>
  <div class="page">
    <header class="hero">
      <Avatar />
      {availability && (
        <p class="status"><span class="status-dot" aria-hidden="true"></span>{availability}</p>
      )}
      <h1>Alejandro Brunacci</h1>
      <p class="role">Senior Backend Engineer · <span class="nowrap">Python &amp; FastAPI</span></p>
      <p class="tagline">Backends for <span class="mark">GenAI and data products</span></p>
      <p class="location">Argentina · Remote · <span class="nowrap">US time zone overlap</span></p>
      <div class="actions">
        <a class="btn btn--primary" href={`mailto:${email}`}><Icon name="mail" /><span>Email me<span class="visually-hidden"> at {email}</span></span></a>
        <a class="btn btn--secondary" href={github}><Icon name="github" /><span>GitHub<span class="visually-hidden"> profile</span></span></a>
        <a class="btn btn--secondary" href={linkedin}><Icon name="linkedin" /><span>LinkedIn<span class="visually-hidden"> profile</span></span></a>
      </div>
      <ul class="stack" aria-label="Technologies">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
    </header>

    <main>
      <section class="about" aria-labelledby="about-title">
        <p class="eyebrow" aria-hidden="true">Who I am</p>
        <h2 id="about-title">About</h2>
        <p>I'm a Senior Backend Engineer with over 10 years of experience in the IT industry, specialized in performance and process optimization: making backends faster, more scalable and more robust. I work with Python, microservices architecture and cloud technologies, and I've built backends for GenAI and data products across Fintech, AgTech and event management systems. I've led multidisciplinary teams of up to 10 people, from MVPs to monolith-to-microservices migrations. Available for remote contract and consulting work.</p>
      </section>

      <section aria-labelledby="projects-title">
        <p class="eyebrow" aria-hidden="true">Selected work</p>
        <h2 id="projects-title">Projects</h2>
        <ul class="projects">
          {/* Projects come from src/data/projects.yaml. */}
          {projects.map(({ data: project }) => {
            // Only a title in another language needs its own element.
            const title = project.lang
              ? <span lang={project.lang}>{project.title}</span>
              : project.title;
            return (
              <li class="project">
                <h3 lang={project.lang}>{project.title}</h3>
                <p class="project-summary">{project.summary}</p>
                {project.stack && (
                  <ul class="tags" aria-label="Built with">
                    {project.stack.map((item) => <li>{item}</li>)}
                  </ul>
                )}
                <p class="project-links">
                  {project.links.live && (
                    <a class="btn btn--tonal" href={project.links.live}><span>Live site<span class="visually-hidden"> of {title}</span></span><Icon name="arrow-up-right" size={16} /></a>
                  )}
                  {project.links.source && (
                    <a class="link" href={project.links.source}><Icon name="github" /><span>Source code<span class="visually-hidden"> on GitHub: {title}</span></span></a>
                  )}
                </p>
              </li>
            );
          })}
        </ul>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <p class="eyebrow" aria-hidden="true">Get in touch</p>
        <h2 id="contact-title">Need a senior Python backend engineer?</h2>
        <p class="contact-text">Tell me about your product, your team and what you need built:</p>
        <div class="actions">
          <a class="btn btn--primary btn--lg" href={`mailto:${email}`}><Icon name="mail" /><span>{emailUser}@<wbr />{emailDomain}</span></a>
          <a class="btn btn--secondary" href={github}><Icon name="github" /><span>GitHub<span class="visually-hidden"> profile</span></span></a>
          <a class="btn btn--secondary" href={linkedin}><Icon name="linkedin" /><span>LinkedIn<span class="visually-hidden"> profile</span></span></a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>© {new Date().getFullYear()} Alejandro Brunacci</p>
    </footer>
  </div>
</body>
</html>
