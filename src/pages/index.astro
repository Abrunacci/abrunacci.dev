---
import { getCollection } from "astro:content";
import Avatar from "../components/Avatar.astro";
import "../styles/global.css";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
// The file loader only logs a YAML error: fail the build instead of
// publishing a page without projects.
if (projects.length === 0) {
  throw new Error("No projects loaded from src/data/projects.yaml");
}
const orders = projects.map((project) => project.data.order);
if (new Set(orders).size !== orders.length) {
  throw new Error("Two projects in src/data/projects.yaml share an order");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Alejandro Brunacci · Senior Backend Engineer (Python &amp; FastAPI)</title>
  <meta name="description" content="Senior Backend Engineer with 10+ years of experience. Python, FastAPI, microservices and AWS. Backends for GenAI and data products. Based in Argentina, remote, with US time zone overlap. Available for contract work.">
  <meta name="author" content="Alejandro Brunacci">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111418" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="https://abrunacci.dev/">

  <meta property="og:type" content="profile">
  <meta property="og:site_name" content="Alejandro Brunacci">
  <meta property="og:url" content="https://abrunacci.dev/">
  <meta property="og:title" content="Alejandro Brunacci · Senior Backend Engineer">
  <meta property="og:description" content="Python &amp; FastAPI. Backends for GenAI and data products. Argentina · Remote · US time zone overlap. Available for contract work.">
  <meta property="og:image" content="https://abrunacci.dev/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Alejandro Brunacci, Senior Backend Engineer. Python and FastAPI. Backends for GenAI and data products.">
  <meta property="og:locale" content="en_US">
  <meta property="profile:first_name" content="Alejandro">
  <meta property="profile:last_name" content="Brunacci">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
</head>
<body>
  <header class="hero">
    <h1>Alejandro Brunacci</h1>
    <p class="tagline">Senior Backend Engineer · Python &amp; FastAPI · Backends for GenAI and data products</p>
    <Avatar />
    <p class="location">Argentina · Remote · <span class="nowrap">US time zone overlap</span></p>
    <p class="hero-contact"><a href="mailto:hello@abrunacci.dev">Email me<span class="visually-hidden"> at hello@abrunacci.dev</span></a></p>
  </header>

  <main>
    <section aria-labelledby="about-title">
      <h2 id="about-title" class="visually-hidden">About</h2>
      <p class="about">I'm a Senior Backend Engineer with over 10 years of experience in the IT industry, specialized in performance and process optimization: making backends faster, more scalable and more robust. I work with Python, microservices architecture and cloud technologies, particularly AWS, and I've built backends for GenAI and data products across Fintech, AgTech and event management systems. I've led multidisciplinary teams of up to 10 people, from MVPs to monolith-to-microservices migrations. Available for remote contract work.</p>
    </section>

    <section aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      <ul class="projects">
        {/* Projects come from src/data/projects.yaml. */}
        {projects.map(({ data: project }) => {
          // Only a title in another language needs its own element.
          const title = project.lang
            ? <span lang={project.lang}>{project.title}</span>
            : project.title;
          return (
            <li class="project">
              <h3 lang={project.lang}>{project.title}</h3>
              <p>{project.summary}</p>
              <p class="project-links">
                {project.links.live && (
                  <a href={project.links.live}>Live site<span class="visually-hidden"> of {title}</span></a>
                )}
                {project.links.source && (
                  <a href={project.links.source}>Source code on GitHub<span class="visually-hidden">: {title}</span></a>
                )}
              </p>
            </li>
          );
        })}
      </ul>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Need a senior Python backend engineer?</h2>
      <p>Tell me about your product, your team and what you need built:</p>
      <p><a class="email" href="mailto:hello@abrunacci.dev">hello@abrunacci.dev</a></p>
      <ul class="profiles">
        <li><a href="https://github.com/Abrunacci">GitHub profile</a></li>
        <li><a href="https://www.linkedin.com/in/abrunacci/">LinkedIn profile</a></li>
      </ul>
    </section>
  </main>
</body>
</html>
