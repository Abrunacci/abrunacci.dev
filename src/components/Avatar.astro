---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// The photo is optional: save it as src/assets/photo.jpg (or .jpeg, .png,
// .webp, .avif, in any case) and it replaces the monogram. Astro writes
// resized AVIF and WebP copies to /assets/ with a hash in their names.
const EXTENSIONS = ["jpg", "jpeg", "png", "webp", "avif"];
const photos = import.meta.glob<ImageMetadata>("../assets/photo.*", {
  import: "default",
});
const paths = Object.keys(photos);
if (paths.length > 1) {
  throw new Error("More than one src/assets/photo.* file: keep only one.");
}
const extension = paths[0]?.split(".").pop()?.toLowerCase();
if (extension && !EXTENSIONS.includes(extension)) {
  throw new Error(`src/assets/photo.${extension}: use one of ${EXTENSIONS.join(", ")}.`);
}
const photo = paths[0] ? await photos[paths[0]]!() : undefined;
---

{
  photo ? (
    <Picture
      pictureAttributes={{ class: "avatar" }}
      class="avatar-img"
      src={photo}
      alt="Portrait of Alejandro Brunacci"
      formats={["avif", "webp"]}
      widths={[88, 128, 176, 256]}
      sizes="(min-width: 40rem) 8rem, 5.5rem"
      width={128}
      height={128}
      fit="cover"
      loading="eager"
    />
  ) : (
    <div class="avatar avatar--placeholder" aria-hidden="true">AB</div>
  )
}
