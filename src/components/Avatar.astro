---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// The photo is optional: save it as src/assets/photo.jpg (or .jpeg, .png,
// .webp, .avif) and it replaces the monogram. Astro writes resized AVIF and
// WebP copies to /assets/ with a hash in their names.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photo.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);
const found = Object.values(photos);
if (found.length > 1) {
  throw new Error("More than one src/assets/photo.* file: keep only one.");
}
const photo = found[0]?.default;
---

{
  photo ? (
    <Picture
      pictureAttributes={{ class: "avatar" }}
      class="avatar-img"
      src={photo}
      alt="Portrait of Alejandro Brunacci"
      formats={["avif", "webp"]}
      widths={[88, 128, 176, 256]}
      sizes="(min-width: 40rem) 8rem, 5.5rem"
      width={128}
      height={128}
      fit="cover"
      loading="eager"
    />
  ) : (
    <div class="avatar avatar--placeholder" aria-hidden="true">AB</div>
  )
}
